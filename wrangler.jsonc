{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "drawy",
	"main": "src/party/index.ts",
	"compatibility_date": "2025-02-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "965a2592d5a34ff393287de2cdc46821",
			"localConnectionString": "${DATABASE_URL}",
		},
	],
	"workers_dev": true,
	"preview_urls": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "Main",
				"class_name": "EditorServer",
			},
			{
				"name": "Rooms",
				"class_name": "OccupancyServer",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"EditorServer",
				"OccupancyServer"
			],
		},
	],
	"assets": {
		// The client bundle that Nitro writes to .output/public. The binding name
		// has to stay "ASSETS": the generated worker reads env.ASSETS.fetch(...)
		// for public files.
		"directory": ".output/public",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
	"previews": {},
}