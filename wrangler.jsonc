{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drawy",
  // Keep this current: it gates the Node.js compatibility layer and the
  // runtime features the Worker relies on.
  "compatibility_date": "2026-10-22",
  // node:crypto (session sealing) and node:process (process.env) are used by
  // the server. Compatibility dates from 2026-08-04 enable this by default;
  // the flag keeps it explicit.
  "compatibility_flags": ["nodejs_compat"],
  // Custom server entry: wraps the TanStack Start handler with Sentry.
  "main": "src/server.ts",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
