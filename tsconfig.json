{
    "include": ["**/*.ts", "**/*.tsx"],
    // Generated by drizzle-kit: snapshots and relations for the migrator, not
    // app code, so they are not type checked.
    "exclude": ["drizzle"],
    "compilerOptions": {
        "target": "ES2022",
        "jsx": "react-jsx",
        "module": "ESNext",
        "paths": {
            "#/*": ["./src/*"],
            "@/*": ["./src/*"]
        },
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,

        /* Linting */
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    }
}